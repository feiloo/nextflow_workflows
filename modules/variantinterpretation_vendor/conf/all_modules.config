/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: PREPAREBEDFILE  {
        publishDir = [
            enabled: false
        ]
    }

    withName: FIRST_COMPRESS  {
        publishDir = [
            enabled: false
        ]
    }

    withName: TABIX_TABIX   {
        publishDir = [
            enabled: false
        ]
    }

    withName: BCFTOOLS_ADDROI {
        publishDir = [
            enabled: false
        ]
        ext.prefix = {
            "${meta.id}_roi_added"
        }
        ext.args = { [
            '--output-type z',
            '--columns CHROM,FROM,TO,ROI'
        ].join(' ').trim()   }
    }

        withName: BCFTOOLS_RMVROI {
        publishDir = [
            path: { "${params.outdir}/vcfs/tag_roi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = { [
            '--output-type z',
            '-x INFO/ROI'
        ].join(' ').trim()   }
    }

    withName: FILTER_TAGROI {
        publishDir = [
            enabled: false
        ]
        ext.args = { [
            '--tag-mode fail',
        ].join(' ').trim() }
    }

        withName: SECOND_COMPRESS {
        publishDir = [
            enabled: false
        ]
        ext.prefix = {
            "${meta.id}_tmp"
        }
    }

        withName: TAGROI_INDEX {
        publishDir = [
            enabled: false
        ]
        ext.prefix = {
            "${meta.id}_tmp"
        }
    }
}
/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: TRANSCRIPT_FILTER {
        publishDir = [
            path: { "${params.outdir}/vcfs/transcriptfiltered" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        //ext.args = { [
        //    '--only_matched',
        //    '--format vcf --soft_filter',
        //    (params.transcriptfilter)       ? "-f \"${params.transcriptfilter} exists\"" : '',
        //].join(' ').trim() }
        ext.args = 'vcf'
    }

    withName: VEMBRANE_CREATE_TAGS {
        publishDir = [
            enabled: false
        ]
    }

    withName: VEMBRANE_TAG {
        publishDir = [
            path: { "${params.outdir}/vcfs/customfilters/tagged" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = { [
            '--annotation-key CSQ',
        ].join(' ').trim() }
    }

    withName: VEMBRANE_FILTER {
        publishDir = [
            path: { "${params.outdir}/vcfs/customfilters/filtered" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = { [
            '--annotation-key CSQ',
        ].join(' ').trim() }
    }
}
/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: ENSEMBLVEP_VEP {
        publishDir = [
            path: { "${params.outdir}/vcfs/ensemblvep" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.prefix = {
            "${meta.id}.ann"
        }
        ext.args = { [
            '--format vcf --offline',
            (params.vep_cache_source)       ? "--${params.vep_cache_source}": '',
            (params.check_existing)         ? '--check_existing'            : '',
            (params.everything)             ? '--everything'                : '',
            (params.no_escape)              ? '--no_escape'                 : '',
            (params.flag_pick)              ? '--flag_pick'                 : '',
            (params.flag_pick_allele)       ? '--flag_pick_allele'          : '',
            (params.flag_pick_allele_gene)  ? '--flag_pick_allele_gene'     : '',
            (params.terms)                  ? "--terms ${params.terms}"     : '',
            (params.clin_sig_allele)        ? '--clin_sig_allele 1'         : '--clin_sig_allele 0',
            (params.exclude_null_alleles)   ? '--exclude_null_alleles'      : '',
            (params.no_check_alleles)       ? '--no_check_alleles'          : '',
            (params.var_synonyms)           ? '--var_synonyms'              : '',
            (params.vep_out_format)         ? "--${params.vep_out_format}"  : '--vcf',
        ].join(' ').trim() }
    }
        
    withName: TMB_CALCULATE  {
        publishDir = [
            path: { "${params.outdir}/reports/tmb" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = { [
            (params.min_af)                     ? "--min_AF ${params.min_af}"                           :   "",
            (params.max_af)                     ? "--max_AF ${params.max_af}"                           :   "",
            (params.min_cov)                    ? "--min_cov ${params.min_cov}"                         :   "",
            (params.max_popfreq)                ? "--popfreq_max ${params.max_popfreq}"                 :   "",
            (params.filter_muttype)             ? "--filter_muttype ${params.filter_muttype}"           :   "",
            (params.filter_consequence)         ? "--filter_consequence ${params.filter_consequence}"   :   "",
            (params.csq_values)                 ? "--csq_values ${params.csq_values}"                   :   "",
            (params.population_db)              ? "--population_db ${params.population_db}"             :   "",
            (params.filter_roi_for_tmb)         ? "--prefilter_region"                                  :   "",
            (params.panelsize_threshold)        ? "--panelsize_threshold ${params.panelsize_threshold}" :   "",
        ].join(' ').trim()  }
    }

    withName: CHECKBEDFILE  {
        publishDir = [
            enabled: false
        ]
    }
}
/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: BCFTOOLS_MERGE {
        publishDir = [
            path: { "${params.outdir}/vcfs/merged_vcfs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = { [
            '--merge none',
        ].join(' ').trim() }
    }

    withName: BCFTOOLS_SAMPLERENAME {
        publishDir = [
            enabled: false
        ]
    }
}
/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: BCFTOOLS_INDEX {
        publishDir = [
            enabled: false
        ]
        ext.args = { [
            '-t',
        ].join(' ').trim()   }
    }

    withName: SAMTOOLS_DICT {
        publishDir = [
            enabled: false
        ]
    }
    withName: SAMTOOLS_FAIDX {
        publishDir = [
            enabled: false
        ]
    }

    withName: GATK4_VALIDATEVARIANTS  {
        publishDir = [
            enabled: false
        ]
        ext.args = { [
            '--validate-GVCF false',
            '--validation-type-to-exclude IDS',
            '--validation-type-to-exclude ALLELES',
            '--validation-type-to-exclude CHR_COUNTS'
        ].join(' ').trim()  }
    }

    withName: BCFTOOLS_STATS  {
        publishDir = [
            path: { "${params.outdir}/reports/multiqc/input/vcfchecks/bcftools_stats" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: VCFCHECKS {
        publishDir = [
            path: { "${params.outdir}/reports/multiqc/input/vcfchecks/" },
            mode: params.publish_dir_mode,
            pattern: '*_warnings.txt'
        ]
        ext.args = { [
            '--check_chr_prefix',
            '--check_vep_annotation',
            '--check_MNPs',
            '--check_gVCF',
            '--check_other_variants',
            '--check_multiallelic_sites',
            '--check_FILTERs'
        ].join(' ').trim() }
    }

    withName: INDEX_FILT {
        publishDir = [
            enabled: false
        ]
        ext.args = { [
            '-t',
        ].join(' ').trim()   }
    }

    withName: INDEX_NORM {
        publishDir = [
            enabled: false
        ]
        ext.args = { [
            '-t',
        ].join(' ').trim()   }
    }

    withName: BCFTOOLS_NORM  {
        publishDir = [
            path: { "${params.outdir}/reports/multiqc/input/bcftools_norm" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.prefix = {
            "${meta.id}_norm"
        }
        ext.args = { [
            '-m-any',
            (params.left_align_indels) ? '--check-ref e' : '--do-not-normalize',
        ].join(' ').trim()  }
    }

    withName: VCFFILTER  {
        publishDir = [
            path: { "${params.outdir}/vcfs/preannotation_filter" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = { [
            (params.filter_vcf)    ? "--apply-filters ${params.filter_vcf}": '',
            '--output-type z',
        ].join(' ').trim()  }
        ext.prefix = { "${meta.id}_filt" }
    }
}
/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    withName: VEMBRANE_CREATE_FIELDS {
        publishDir = [
            enabled: false
        ]
        ext.args = { [
            '--other_fields CHROM,POS,ID,REF,ALT,QUAL,FILTER',
            (params.allele_fraction)        ? "--allele_fraction ${params.allele_fraction}" : '',
            (params.read_depth)             ? "--read_depth ${params.read_depth}"           : '',
            (params.format_fields)          ? "--format_fields ${params.format_fields}"     : '',
            (params.info_fields)            ? "--info_fields ${params.info_fields}"         : '',
        ].join(' ').trim() }
    }

    withName: VEMBRANE_VEMBRANETABLE {
        publishDir = [
            path: { "${params.outdir}/reports/TSV" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = { [
            '--annotation-key CSQ',
        ].join(' ').trim() }
    }

    withName: PREPROCESS_DATAVZRD {
        publishDir = [
            enabled: false
        ]
        ext.args = { [
            '--ann_name_column identifier',
            '--ann_group_column group',
            '--identifiers chrom pos ref alt id feature',
        ].join(' ').trim() }
    }

    withName: DATAVZRD {
        publishDir = [
            path: { "${params.outdir}/reports/HTML" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        ext.args = { [
            '--webview-url null',
        ].join(' ').trim() }
    }

    withName: DUMP_WARNINGS  {
        publishDir = [
            enabled: false,
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = params.multiqc_title ? "--title \"$params.multiqc_title\"" : ''
        publishDir = [
            path: { "${params.outdir}/reports/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
